{
  "name": "smart-stock-pharmacy-management",
  "version": "1.0.0",
  "description": "Smart Pharmacy Management System — Portable Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.smartpharmacy.app",
    "productName": "Smart Pharmacy Management System",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "main.js",
      "frontend/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir"
    },
    "extraFiles": [
      {
        "from": "backend/dist/SmartPharmacyBackend",
        "to": "backend-dist/SmartPharmacyBackend",
        "filter": ["**/*"]
      }
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  }
}
